-# Patch function is possibly unused but retained for future use
+# A downloaded patch file does not imply that its source changes were applied.
+# Patch on local scratch space, then overwrite the existing NERSC inode so its
+# owner and collaboration group remain unchanged.
 function patch_acts() {
   local url="$1"
   local file="$(basename "$1")"
+  local patch_file
+  local patch_workdir
+  local archive_dir
+  local target
+  local targets=()
   if [ ! -e "$file" ]; then
     wget "$url"
-    patch -p1 --forward --input="$file" || git apply --whitespace=nowarn "$file"
+  fi
+  if patch --dry-run --reverse -p1 --input="$file" </dev/null >/dev/null 2>&1; then
+    echo "ACTS patch $file is already applied."
+  elif patch --dry-run --forward -p1 --input="$file" </dev/null >/dev/null 2>&1; then
+    patch_file="$(realpath "$file")"
+    patch_workdir="$(mktemp -d "${TMPDIR:-/tmp}/acts-material-map-patch.XXXXXX")"
+    archive_dir="../../proj_svt_disk_tiling/tmp/retained/$(date -u '+%Y-%m-%d')/material_map_patches"
+    mapfile -t targets < <(sed -n 's|^--- a/||p' "$file")
+    if [[ "${#targets[@]}" -eq 0 ]]; then
+      echo "ERROR: ACTS patch $file has no recognized source files." >&2
+      exit 1
+    fi
+    for target in "${targets[@]}"; do
+      if [[ "$target" != Examples/* || "$target" == *../* || ! -f "$target" ]]; then
+        echo "ERROR: invalid or missing ACTS patch target: $target" >&2
+        exit 1
+      fi
+      mkdir -p "$patch_workdir/$(dirname "$target")"
+      mkdir -p "$patch_workdir/original/$(dirname "$target")"
+      cp "$target" "$patch_workdir/$target"
+      cp "$target" "$patch_workdir/original/$target"
+    done
+    (cd "$patch_workdir" && patch --forward -p1 --input="$patch_file" </dev/null)
+    for target in "${targets[@]}"; do
+      cp "$patch_workdir/$target" "$target"
+    done
+    mkdir -p "$archive_dir"
+    mv "$patch_workdir" "$archive_dir/"
+    printf '%s | %s | %s/%s | retained scratch | apply ACTS patch without replacing NERSC file ownership\n' \
+      "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$file" "$archive_dir" "$(basename "$patch_workdir")" \
+      >> ../../proj_svt_disk_tiling/tmp/file_actions.log
+  else
+    echo "ERROR: ACTS patch $file cannot be applied cleanly." >&2
+    exit 1
   fi
 }
